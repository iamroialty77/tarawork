# Public application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000

# Supabase public client
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
# Public Cloudflare Turnstile site key. The matching secret is configured only in Supabase Dashboard.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only Supabase and database credentials
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres

# AI providers (configure only the providers in use)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible AI for Blog Autopilot (Ollama, LocalAI, etc.).
# A Vercel deployment cannot use localhost; expose Docker through a secured HTTPS
# tunnel/host, include /v1, and protect it with a long bearer token.
BLOG_AI_BASE_URL=
BLOG_AI_API_KEY=
BLOG_AI_MODEL=llama3.1:8b
# Optional Cloudflare Access service token for a protected tunnel.
BLOG_AI_ACCESS_CLIENT_ID=
BLOG_AI_ACCESS_CLIENT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=
OCR_SPACE_API_KEY=

# Scheduled jobs
# Generate a long random secret; Vercel sends it as a Bearer token.
CRON_SECRET=

# JSON array of trusted HTTPS RSS feeds. RSS jobs expire after 14-30 days.
RSS_JOB_FEEDS=[{"name":"Example Jobs","url":"https://example.com/jobs.xml"}]
RSS_JOB_EXPIRY_DAYS=21

# GitHub webhook
# Use a random value of at least 32 characters.
GITHUB_WEBHOOK_SECRET=
# Keep false until the real financial adapter is idempotent and production-approved.
GITHUB_FINANCIAL_WEBHOOK_ENABLED=false

# Trello
TRELLO_API_KEY=
TRELLO_API_SECRET=
TRELLO_TOKEN=
# Use a long random value. Changing it invalidates encrypted stored tokens.
TRELLO_TOKEN_ENCRYPTION_KEY=

# Outgoing and incoming email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
CONTACT_EMAIL=
MARKETING_EMAIL_FROM_NAME=TaraWork

# Optional integrations and operational limits
EXCHANGERATE_API_KEY=
ADMIN_EMAIL_STORAGE_LIMIT_BYTES=52428800
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Sheets import (server-side OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/admin/google-sheets/callback

# Google Search Console SEO Autopilot (same Google OAuth project)
# Add this exact callback to Google Cloud Console > Authorized redirect URIs.
GOOGLE_SEARCH_CONSOLE_REDIRECT_URI=http://localhost:3000/api/admin/seo-automation/google/callback
# Optional dedicated encryption secret. If empty, GOOGLE_CLIENT_SECRET is used.
SEO_TOKEN_ENCRYPTION_KEY=
